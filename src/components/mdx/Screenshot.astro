---
/**
 * Captioned screenshot with theme-consistent framing.
 */
interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="screenshot">
  <img src={src} alt={alt} loading="lazy" decoding="async" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .screenshot {
    margin-block: 1.8em;
  }

  img {
    display: block;
    width: 100%;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--bg-dark);
  }

  figcaption {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-muted);
    text-align: center;
  }
</style>
