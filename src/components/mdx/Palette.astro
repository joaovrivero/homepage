---
import ColorSwatch from "./ColorSwatch.astro";

interface Swatch {
  name: string;
  value: string;
  role?: string;
}

interface Props {
  title?: string;
  colors?: Swatch[];
}

// pinacoteca:begin
/** Default: the canonical Pinacoteca palette. */
const defaultColors: Swatch[] = [
  { name: "bg-deep", value: "#0C0805", role: "deepest surfaces" },
  { name: "bg-dark", value: "#120D09", role: "nav / footer / code" },
  { name: "bg", value: "#18130E", role: "page background · Vermeer" },
  { name: "bg-raised", value: "#211C17", role: "cards" },
  { name: "bg-elevated", value: "#2E2822", role: "hover states" },
  { name: "fg-muted", value: "#7D6B59", role: "comments" },
  { name: "fg-secondary", value: "#B19A80", role: "metadata" },
  { name: "fg", value: "#E6CCAF", role: "body text · Vermeer" },
  { name: "fg-bright", value: "#F7E5CF", role: "headings" },
  { name: "gold-dark", value: "#9B6E06", role: "quiet accent" },
  { name: "gold", value: "#D7A447", role: "identity accent · gold ground" },
  { name: "gold-bright", value: "#EFBB5F", role: "highlights" },
  { name: "red", value: "#D67066", role: "errors · Matejko" },
  { name: "orange", value: "#D77F47", role: "numbers · Kuindzhi" },
  { name: "green", value: "#88AB75", role: "strings · Van Gogh" },
  { name: "aqua", value: "#6CABAB", role: "escapes · Van Gogh" },
  { name: "blue", value: "#799DBB", role: "functions · Hokusai" },
  { name: "purple", value: "#AD8AB6", role: "keywords · Klimt" },
];
// pinacoteca:end

const { title, colors = defaultColors } = Astro.props;
---

<figure class="palette">
  {title && <figcaption class="eyebrow">{title}</figcaption>}
  <div class="grid">
    {colors.map((c) => <ColorSwatch name={c.name} value={c.value} role={c.role} />)}
  </div>
</figure>

<style>
  .palette {
    margin-block: 1.8em;
  }

  figcaption {
    margin-bottom: 0.8rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11.5rem, 1fr));
    gap: 0.5rem;
  }
</style>
