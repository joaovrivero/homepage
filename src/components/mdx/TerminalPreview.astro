---
/**
 * A small terminal window frame for command/output examples.
 * Content goes in the default slot — usually a fenced code block,
 * or plain <pre> text.
 */
interface Props {
  title?: string;
}

const { title = "~ zsh" } = Astro.props;
---

<figure class="terminal">
  <figcaption class="bar">
    <span class="dot red"></span>
    <span class="dot yellow"></span>
    <span class="dot jade"></span>
    <span class="title">{title}</span>
  </figcaption>
  <div class="screen">
    <slot />
  </div>
</figure>

<style>
  /* A small application window: raised chrome, recessed screen. */
  .terminal {
    margin-block: 1.8em;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg-deep);
    box-shadow: var(--shadow-raise), inset 0 1px 0 var(--hl-top);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.9rem;
    background: var(--bg-raised);
    border-bottom: 1px solid var(--edge);
    box-shadow: inset 0 1px 0 var(--hl-top);
  }

  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    opacity: 0.75;
  }

  .dot.red {
    background: var(--red);
  }

  .dot.yellow {
    background: var(--yellow);
  }

  .dot.jade {
    background: var(--jade);
  }

  .title {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--fg-muted);
  }

  .screen {
    padding: 0.35rem 0.25rem;
    box-shadow: var(--shadow-inset);
  }

  .screen :global(pre) {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    margin: 0;
    border-radius: 0;
  }
</style>
