---
interface Props {
  name: string;
  value: string;
  /** Use a dark label for very light swatches. */
  role?: string;
}

const { name, value, role } = Astro.props;
---

<div class="swatch">
  <span class="chip" style={`background:${value}`}></span>
  <span class="info">
    <span class="name">{name}</span>
    <code class="value">{value.toLowerCase()}</code>
    {role && <span class="role">{role}</span>}
  </span>
</div>

<style>
  .swatch {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.45rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--bg-raised);
  }

  .chip {
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 4px;
    flex-shrink: 0;
    border: 1px solid color-mix(in srgb, var(--fg-bright) 12%, transparent);
    box-shadow: 0 1px 0 var(--edge), inset 0 1px 0 var(--hl-top);
  }

  .info {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
    min-width: 0;
  }

  .name {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg);
  }

  .value {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--fg-muted);
  }

  .role {
    font-size: 0.6875rem;
    color: var(--fg-secondary);
  }
</style>
